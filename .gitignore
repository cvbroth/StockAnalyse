# Python 临时文件与虚拟环境
__pycache__/
*.py[cod]
.venv/

# 本地行情数据库及其 SQLite 辅助文件
data/*.db
data/*.db-shm
data/*.db-wal

# 每次运行生成的筛选结果
output/*.json
output/*.csv
output/runs/
output/reports/
output/openclaw_exchange/
output/.daily_pipeline.lock
output/logs/

# 本地密钥配置
.env

# 当前机器使用的项目运行配置（初始化时自动生成）
config/project.json
config/project.json.tmp
