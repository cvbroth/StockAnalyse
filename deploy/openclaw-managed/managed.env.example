# Absolute host path of this repository.
STOCKANALYSE_PROJECT_DIR=/home/chen/stockAnalyse/StockAnalyse

# Use the exact image/tag already used by the OpenClaw Gateway deployment.
OPENCLAW_IMAGE=replace-with-current-openclaw-image
OPENCLAW_RUNTIME_USER=node
OPENCLAW_TZ=Asia/Shanghai

# Optional. Copy an exact provider/model id from `openclaw models list --json`.
# Leave empty to inherit the normal OpenClaw default.
A_SHARE_RESEARCH_MODEL=
